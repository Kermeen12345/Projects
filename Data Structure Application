        self.pop_button.grid(row=2, column=3, ipadx=5, ipady=5, padx=5, sticky=W)

        self.peek_button = Button(self.root, text="Peek", font=("Script MT Bold", 14), command=self.peek)
        self.peek_button.grid(row=2, column=4, ipadx=5, ipady=5, padx=5, sticky=W)

        self.is_empty_button = Button(self.root, text="Is Empty", font=("Script MT Bold", 14), command=self.is_empty)
        self.is_empty_button.grid(row=2, column=5, ipadx=5, ipady=5, padx=5, sticky=W)

        # Canvas to visualize the stack
        self.canvas = Canvas(self.root, width=600, height=400, bg='white')
        self.canvas.grid(row=3, column=0, columnspan=6, padx=10, pady=10)

        # Initialize stack and related variables
        self.stack = []
        self.stack_top = 0
        self.stack_size = 5  # Default stack size
        self.item_height = 40  # Height of each stack item in the visualization

        # Add a button to set the stack size
        self.set_size_button = Button(self.root, text="Set Stack Size", font=("Script MT Bold", 14), command=self.set_stack_size)
        self.set_size_button.grid(row=1, column=2, ipadx=5, ipady=5, padx=5, sticky=W)

    def draw_stack(self):
        """Function to draw the stack on the canvas."""
        self.canvas.delete("all")
        y = 400
        for item in self.stack:
            self.canvas.create_rectangle(200, y - self.item_height, 400, y, fill="dark turquoise")
            self.canvas.create_text(300, y - self.item_height // 2, text=item, font=("Script MT Bold", 16))
            y -= self.item_height

    def set_stack_size(self):
        """Function to set the stack size based on user input."""
        try:
            self.stack_size = int(self.size_entry.get())
            if self.stack_size <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Error", "Please enter a valid positive integer for stack size")

    def push(self):
        """Function to push an element onto the stack."""
        if self.stack_top < self.stack_size:
            item = self.input_entry.get()
            if item:
                self.stack.append(item)
                self.input_entry.delete(0, END)
                self.draw_stack()
                self.stack_top += 1
            else:
                messagebox.showwarning("Warning", "Please enter a number")
        else:
            messagebox.showwarning("Warning", "Stack Overflow")

    def pop(self):
        """Function to pop an element from the stack."""
        if self.stack:
            self.stack.pop()
            self.draw_stack()
            self.stack_top -= 1
        else:
            messagebox.showwarning("Warning", "Stack Underflow")

    def peek(self):
        """Function to peek at the top element of the stack."""
        if self.stack:
            top_item = self.stack[-1]
            messagebox.showinfo("Peek", f"Top item: {top_item}")
        else:
            messagebox.showwarning("Warning", "Stack is empty")

    def is_empty(self):
        """Function to check if the stack is empty."""
        if self.stack:
            messagebox.showinfo("Is Empty", "Stack is not empty")
        else:
            messagebox.showinfo("Is Empty", "Stack is empty")

